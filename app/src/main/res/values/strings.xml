    <!-- Advanced: exposure -->
    <string name="section_exposure">Exposure</string>
    <string name="advanced_exposure_description">AUTO keeps exposure under the OEM ISP/AE. MANUAL fixes shutter and ISO and is mainly useful for controlled tests.</string>
    <string name="advanced_exposure_recommendation">Flagships: use AUTO for normal recording; use MANUAL only under stable lighting.</string>
    <string name="android_low_light_boost">Android low-light boost</string>
    <string name="low_light_boost_subtitle">OEM brightness-priority AE</string>
    <string name="low_light_boost_subtitle_lux">OEM brightness-priority AE · %1$.1f–%2$.1f lux</string>
    <string name="advanced_low_light_boost_description">Asks the OEM pipeline to prioritize brightness in very dark scenes. It can increase noise and work against a strict frame-rate target.</string>
    <string name="advanced_low_light_boost_recommendation">Flagships: keep OFF for Telegram-like smooth 30 fps; enable only when brightness matters more than motion clarity.</string>
    <string name="ae_priority">AE priority</string>
    <string name="advanced_ae_priority_description">Shutter priority constrains exposure time while AE varies ISO; ISO priority does the opposite.</string>
    <string name="advanced_ae_priority_recommendation">Flagships: OFF by default. Shutter priority is useful for testing a fixed 1/30 exposure in low light.</string>
    <string name="priority_shutter">Priority shutter · %1$s</string>
    <string name="priority_iso">Priority ISO · %1$d</string>
    <string name="exposure_compensation">Exposure compensation · %1$s</string>
    <string name="advanced_exposure_compensation_description">Biases the target brightness of automatic exposure without switching to Manual.</string>
    <string name="advanced_exposure_compensation_recommendation">Flagships: keep 0 EV. Change only when the OEM consistently under- or overexposes the subject.</string>
    <string name="ae_lock">AE lock</string>
    <string name="ae_lock_hint">Freeze automatic exposure</string>
    <string name="shutter">Shutter · %1$s</string>
    <string name="iso">ISO · %1$d</string>
    <string name="anti_banding">Anti-banding</string>
    <string name="advanced_antibanding_description">Aligns exposure timing with mains-powered lighting to reduce flicker and banding.</string>
    <string name="advanced_antibanding_recommendation">Flagships: AUTO. Force 50 Hz in Europe/Russia or 60 Hz in the US and some Asian regions only when AUTO gets it wrong.</string>

    <!-- Advanced: white balance -->
    <string name="section_white_balance">White balance</string>
    <string name="awb_incandescent">Incandescent</string>
    <string name="awb_fluorescent">Fluorescent</string>
    <string name="awb_warm_fluorescent">Warm fluorescent</string>
    <string name="awb_daylight">Daylight</string>
    <string name="awb_cloudy">Cloudy</string>
    <string name="awb_twilight">Twilight</string>
    <string name="awb_shade">Shade</string>
    <string name="advanced_awb_description">Controls white balance. AUTO tracks lighting changes; fixed presets reduce color shifts in controlled light.</string>
    <string name="advanced_awb_recommendation">Flagships: use AUTO. Fix white balance only under constant lighting or for A/B tests.</string>
    <string name="awb_lock">AWB lock</string>
    <string name="awb_lock_hint">Freeze the current white balance</string>
    <string name="color_correction">Color correction</string>
    <string name="advanced_color_correction_description">Selects the standard Camera2 color-correction pipeline. FAST targets realtime video; CCT exposes manual Kelvin and Tint.</string>
    <string name="advanced_color_correction_recommendation">Flagships: FAST. Use CCT only under controlled lighting or for color-rendering comparisons.</string>
    <string name="color_temperature">Color temperature · %1$d K</string>
    <string name="color_tint">Color tint · %1$d</string>

    <!-- Advanced: focus/lens -->
    <string name="section_focus">Focus</string>
    <string name="advanced_focus_description">Continuous Video keeps AF tracking motion. Manual fixes the focus plane.</string>
    <string name="advanced_focus_recommendation">Flagships: Continuous Video. Use Manual only on a tripod or at a fixed subject distance.</string>
    <string name="focus_distance">Focus distance · %1$.2f D</string>
    <string name="aperture">Aperture</string>
    <string name="aperture_value">f/%1$.1f</string>
    <string name="advanced_aperture_description">Only available on cameras with a physically variable aperture. Lower f-numbers admit more light and reduce depth of field.</string>
    <string name="advanced_aperture_recommendation">Flagships: use OEM so the manufacturer can select the aperture for the scene.</string>

    <!-- Advanced: stabilization -->
    <string name="section_stabilization">Stabilization</string>
    <string name="advanced_stabilization_description">Preview stabilization requests a stabilized viewfinder and recording path; Video is the conventional EIS mode.</string>
    <string name="advanced_stabilization_recommendation">Flagships: use Preview when available, otherwise Video or OEM. Use OFF only to measure raw camera movement.</string>
    <string name="optical_stabilization">Optical stabilization</string>
    <string name="advanced_ois_description">Controls physical optical stabilization when the Camera2 HAL exposes the control.</string>
    <string name="advanced_ois_recommendation">Flagships: use OEM. Do not force OIS together with aggressive EIS without a separate A/B test.</string>

    <!-- Advanced: ISP -->
    <string name="section_isp_processing">ISP processing</string>
    <string name="hot_pixel_correction">Hot-pixel correction</string>
    <string name="hot_pixel_description">Suppresses isolated hot or defective sensor pixels.</string>
    <string name="hot_pixel_recommendation">Flagships: FAST for realtime video; use OFF only to inspect raw sensor behavior.</string>
    <string name="lens_shading_correction">Lens shading correction</string>
    <string name="lens_shading_description">Compensates lens vignetting and color shading toward frame edges.</string>
    <string name="lens_shading_recommendation">Flagships: FAST. OFF is useful only for diagnostic ISP comparisons.</string>
    <string name="edge_enhancement">Edge enhancement / sharpening</string>
    <string name="edge_enhancement_description">Adds edge sharpening. Aggressive processing can emphasize noise and halos.</string>
    <string name="edge_enhancement_recommendation">Flagships: FAST is a safe realtime baseline; use OFF when you want a more natural image for later processing.</string>
    <string name="lens_distortion_correction">Lens distortion correction</string>
    <string name="lens_distortion_description">Corrects geometric lens distortion, especially visible on ultrawide cameras.</string>
    <string name="lens_distortion_recommendation">Flagships: FAST. Use OFF only to compare the uncorrected sensor/lens geometry.</string>
    <string name="chromatic_aberration_correction">Chromatic aberration correction</string>
    <string name="chromatic_aberration_description">Reduces colored fringes around high-contrast edges.</string>
    <string name="chromatic_aberration_recommendation">Flagships: FAST for video. HQ is useful only if the HAL still sustains the requested FPS.</string>
    <string name="tonemap">Tonemap</string>
    <string name="tonemap_description">Maps sensor dynamic range into the SDR image before the BT.709 encode stage.</string>
    <string name="tonemap_recommendation">Flagships: FAST for continuous video. Test HQ separately at 30 fps because it can increase latency.</string>

